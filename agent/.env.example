# Copy to .env and fill in actual values.
# .env is gitignored — never commit.

# Network selection: testnet | mainnet
MEMOGENT_NETWORK=testnet

# Somnia RPC endpoint (chain 50312 for testnet)
SOMNIA_RPC=https://api.infra.testnet.somnia.network/

# Deployed contract addresses (fill after running sc deploy)
MEMOGENT_CORE_ADDRESS=0x
MEMOGENT_AGENT_ADDRESS=0x
TIME_CAPSULE_ADDRESS=0x

# Service wallet — pays gas for assessRisk calls + read-only RPC ops
# IMPORTANT: separate from inheritance vault wallets. Use a dedicated service wallet.
SERVICE_PRIVATE_KEY=0x

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Pinata IPFS (Time Capsule storage — get JWT from pinata.cloud)
PINATA_JWT=

# Supabase (PostgreSQL hosted)
# - URL format: https://<project-ref>.supabase.co
# - SERVICE_ROLE_KEY bypasses RLS — agent server only, NEVER expose to FE
# - Bima FE uses the SUPABASE_ANON_KEY instead (not needed here)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Logging level: trace | debug | info | warn | error
LOG_LEVEL=info

# Activity tracking debounce — max writes per chat (ms)
# Prevents burning Supabase rate limits on chatty users
ACTIVITY_DEBOUNCE_MS=60000

# AutoAssess dispatcher tuning.
# Production defaults (5-min tick, 1-hour per-will cooldown) keep LLM call
# cost low — each assessment burns ~0.3 STT deposit on the Agent Platform.
# For short-window demos override these in Railway env so the LLM gets to
# escalate SAFE → WATCH → GRACE → EXECUTE inside a 20-minute test window.
#
#   Production (leave UNSET)
#     # AUTO_ASSESS_TICK_INTERVAL_MS=300000   (5 min)
#     # AUTO_ASSESS_COOLDOWN_MS=3600000       (1 hour)
#
#   Demo recording (Railway env)
#     AUTO_ASSESS_TICK_INTERVAL_MS=60000     # 1 min
#     AUTO_ASSESS_COOLDOWN_MS=180000         # 3 min
#
# REVERT to unset on Railway after recording — short values amplify LLM
# deposit burn 20-30x per active will.
# AUTO_ASSESS_TICK_INTERVAL_MS=
# AUTO_ASSESS_COOLDOWN_MS=
