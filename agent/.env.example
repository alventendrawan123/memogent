# Copy to .env and fill in actual values.
# .env is gitignored — never commit.

# Network selection: testnet | mainnet
MEMOGENT_NETWORK=testnet

# Somnia RPC endpoint (chain 50312 for testnet)
SOMNIA_RPC=https://api.infra.testnet.somnia.network/

# Deployed contract addresses (fill after running sc deploy)
MEMOGENT_CORE_ADDRESS=0x
MEMOGENT_AGENT_ADDRESS=0x

# Service wallet — pays gas for assessRisk calls + read-only RPC ops
# IMPORTANT: separate from inheritance vault wallets. Use a dedicated service wallet.
SERVICE_PRIVATE_KEY=0x

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Lighthouse IPFS (Time Capsule encryption, W3 feature)
LIGHTHOUSE_API_KEY=

# Supabase (PostgreSQL hosted)
# - URL format: https://<project-ref>.supabase.co
# - SERVICE_ROLE_KEY bypasses RLS — agent server only, NEVER expose to FE
# - Bima FE uses the SUPABASE_ANON_KEY instead (not needed here)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Logging level: trace | debug | info | warn | error
LOG_LEVEL=info

# Activity tracking debounce — max writes per chat (ms)
# Prevents burning Supabase rate limits on chatty users
ACTIVITY_DEBOUNCE_MS=60000
